# Normalize line endings: LF in the repository on every platform.
# Keeps `ruff format --check` and diffs consistent between Windows dev and Linux CI.
* text=auto eol=lf

# Explicitly mark common text types.
*.py    text eol=lf
*.toml  text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
